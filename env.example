# ILA-SOC Environment Configuration

# Flask Session / JWT Secret Key (required for production)
SESSION_SECRET=your_super_secret_session_key_here
AUTH_SECRET=your_jwt_signing_secret_here

# Google OAuth Credentials (for Sign-In with Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=False

# API Keys
AGENT_API_KEY=your_agent_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
